
<http://localhost/execution> {
  <http://localhost/execution> a <http://linkedpipes.com/ontology/Pipeline>;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Empty pipeline";
    <http://linkedpipes.com/ontology/executionMetadata> <http://localhost/execution/metadata>;
    <http://linkedpipes.com/ontology/profile> <http://localhost/execution/profile>;
    <http://linkedpipes.com/ontology/repository> <http://localhost/repository/sesame> .
  
  <http://localhost/execution/metadata> a <http://linkedpipes.com/ontology/ExecutionMetadata>;
    <http://linkedpipes.com/ontology/deleteWorkingData> true;
    <http://linkedpipes.com/ontology/saveDebugData> false;
    <http://linkedpipes.com/ontology/logPolicy> <http://linkedpipes.com/ontology/log/Preserve>;
    <http://linkedpipes.com/ontology/logLevel> "DEBUG";
    <http://linkedpipes.com/ontology/execution/type> <http://linkedpipes.com/resources/executionType/Full> .
  
  <http://localhost/execution/profile> <http://linkedpipes.com/ontology/rdfRepositoryPolicy>
      <http://linkedpipes.com/ontology/repository/SingleRepository>;
    <http://linkedpipes.com/ontology/rdfRepositoryType> <http://linkedpipes.com/ontology/repository/NativeStore> .
  
  <http://localhost/repository/sesame> a <http://linkedpipes.com/ontology/dataUnit/sesame/1.0/Repository>;
    <http://linkedpipes.com/ontology/requirement> <http://linkedpipes.com/resources/requirement/workingDirectory> .
}
